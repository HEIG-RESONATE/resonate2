@startuml
!theme plain
skinparam classAttributeIconSize 0

class Event {
  +id: ObjectId
  +title: StringField
  +date: DateTimeField
  +points: DictField
  +extra: DictField
  +images: ListField
  --
  +save()
  +delete()
}

class EventCreate {
  +title: str
  +date: str
  +points: Optional[dict]
  +extra: Optional[dict]
  +images: Optional[list]
  --
  +validate_extra_size()
}

class EventOut {
  +id: str
  +title: str
  +date: str
  +points: Optional[dict]
  +extra: Optional[dict]
  +images: Optional[list]
}

class LoginRequest {
  +password: str
}

class TokenResponse {
  +access_token: str
  +token_type: str
}

EventCreate ..> Event : creates
Event ..> EventOut : serializes
LoginRequest ..> TokenResponse : authenticates

@enduml
