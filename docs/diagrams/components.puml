@startuml
!theme plain
skinparam classAttributeIconSize 0

class NewsItem {
  +title: str
  +url: Optional[str]
  +author: Optional[str]
  +extra: Optional[dict]
  --
  +validate_extra_size()
}

class Event {
  +id: ObjectId
  +title: StringField
  +date: DateTimeField
  +points: DictField
  +extra: DictField
  +images: ListField
  +news: ListField[NewsItem]
  --
  +save()
  +delete()
}

class EventCreate {
  +title: str
  +date: str
  +points: Optional[dict]
  +extra: Optional[dict]
  +images: Optional[list]
  +news: Optional[List[NewsItem]]
  --
  +validate_extra_size()
}

class EventOut {
  +id: str
  +title: str
  +date: str
  +points: Optional[dict]
  +extra: Optional[dict]
  +images: Optional[list]
  +news: Optional[List[NewsItem]]
}

class LoginRequest {
  +password: str
}

class TokenResponse {
  +access_token: str
  +token_type: str
}

EventCreate ..> Event : creates
Event ..> EventOut : serializes
LoginRequest ..> TokenResponse : authenticates
Event "1" *-- "*" NewsItem : contains

@enduml
