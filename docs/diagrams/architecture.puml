@startuml
!theme plain
skinparam componentStyle rectangle
skinparam defaultFontName "Arial"

package "Frontend" {
  [Vue 3 SPA] as [Vue]
  [Leaflet Map] as [Map]
  [Nginx] as [Nginx]
}

package "Backend" {
  [FastAPI Routes] as [API]
  [Auth Module] as [Auth]
  [Event Service] as [EventService]
  [Image Service] as [ImageService]
  [MongoEngine ODM] as [ODM]
}

package "Data" {
  database "MongoDB" as [Mongo]
  storage "Image Storage" as [Images]
}

[Nginx] --> [Vue] : serves static files
[Nginx] --> [API] : proxies /api/*
[Vue] --> [API] : REST API calls
[API] --> [Auth] : JWT validation
[API] --> [EventService] : event CRUD
[API] --> [ImageService] : upload, signing, secure serving
[EventService] --> [ODM] : document operations
[ImageService] --> [Images] : file storage
[ODM] --> [Mongo] : queries

@enduml
